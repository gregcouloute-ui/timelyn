# Everline environment variables.
# Copy to .env.local for local development. Never commit real values.

# --- Supabase (leave blank to run in local demo mode) ---------------------
# Project URL and the public anon/publishable key, from
# Supabase dashboard > Project Settings > API. The anon key is safe to expose
# to browsers: Row Level Security protects every table and file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ------------------------------------------------------------------
# Public URL, used for invitation links and auth email redirects.
# On Vercel this falls back to VERCEL_URL if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to force demo mode even when Supabase is configured.
EVERLINE_FORCE_DEMO=
